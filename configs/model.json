  "architecture": {
    "representation": "concatenate normalized CLS token and mean normalized patch token",
    "representation_dimension": 1536,
    "feature_normalization": "LayerNorm(1536)",
    "classifier": "Linear(1536, 12)",
    "number_of_classes": 12,
    "regression_head": "Linear(1536, 1) with sigmoid scaled to BBCH 0-99",
